# PaperPulse AI — Environment Configuration
# Copy this file to .env and fill in your values.

# ── LLM (OpenAI-compatible) ─────────────────────────────────
# Base URL for any OpenAI-compatible API (OpenAI, Together, local, etc.)
LLM_BASE_URL=https://api.openai.com/v1

# Your API key (mandatory)
LLM_API_KEY=sk-...

# Model to use
LLM_MODEL=gpt-4o-mini

# Max output tokens for script generation (default 4096)
LLM_MAX_TOKENS=4096

# ── Arxiv ────────────────────────────────────────────────────
# Number of papers per episode (1-3 recommended)
MAX_PAPERS=2

# ── RSS Feed / Podcast Hosting ───────────────────────────────
# Public URL where feed.xml is served (submitted to Spotify/Apple)
FEED_URL=https://example.com/feed.xml

# Public base URL for your site
SITE_URL=https://example.com

# Public URL where episode MP3s are served (no trailing slash)
EPISODES_BASE_URL=https://example.com/episodes

# Podcast cover art URL (≥1400x1400px JPEG/PNG, required by Apple/Spotify)
COVER_URL=https://example.com/cover.jpg

# Podcast author name and contact email
PODCAST_AUTHOR=PaperPulse AI
PODCAST_EMAIL=podcast@example.com

# ── Monitoring & Alerting (Optional) ─────────────────────────
# Healthchecks.io or UptimeRobot webhook URL (appends /fail on error)
HEALTHCHECK_URL=
